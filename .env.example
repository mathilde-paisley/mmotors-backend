# ============================================================
# Variables d'environnement attendues pour le projet M-Motors
# Ce fichier sert d'exemple et ne contient aucune valeur réelle.
# Le fichier .env réel ne doit jamais être versionné dans Git.
# ============================================================

# Environnement d'exécution
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Base de données PostgreSQL
DATABASE_URL=

# Sécurité applicative
SECRET_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Alerting e-mail
EMAIL_ALERT_TO=
